# Copy to .env and adjust. Never commit the real .env.
ATHEER_CLINIC_NAME="Atheer Clinic"
ATHEER_CLINIC_TIMEZONE="Asia/Riyadh"
# Development: SQLite. Production: postgresql+psycopg://user:pass@host:5432/atheer
ATHEER_DATABASE_URL="sqlite:///./atheer.db"
ATHEER_DATABASE_ECHO=false
ATHEER_DEFAULT_SLOT_MINUTES=15
ATHEER_LATE_GRACE_MINUTES=10
ATHEER_REMINDER_LEAD_HOURS=24
