# Copy to .env and adjust. Never commit the real .env.
ATHEER_CLINIC_NAME="Atheer Clinic"
ATHEER_CLINIC_TIMEZONE="Asia/Riyadh"
# Development: SQLite. Production: postgresql+psycopg://user:pass@host:5432/atheer
ATHEER_DATABASE_URL="sqlite:///./atheer.db"
ATHEER_DATABASE_ECHO=false
ATHEER_DEFAULT_SLOT_MINUTES=15
ATHEER_LATE_GRACE_MINUTES=10
ATHEER_REMINDER_LEAD_HOURS=24

# API server (atheer-server). Staff endpoints stay disabled until a key is set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATHEER_API_HOST=127.0.0.1
ATHEER_API_PORT=8000
# ATHEER_STAFF_API_KEY=

# Voice (pip install -e ".[voice]")
ATHEER_VOICE_ENABLED=false
ATHEER_TTS_ENGINE=auto                # auto | pyttsx3 | piper | console
ATHEER_TTS_RATE=165
ATHEER_STT_ENGINE=faster-whisper      # faster-whisper | openai-whisper
ATHEER_STT_MODEL=medium
# ATHEER_VOICE_MODEL_AR=C:/atheer/voices/ar_JO-kareem-medium.onnx
# ATHEER_VOICE_MODEL_EN=C:/atheer/voices/en_US-amy-medium.onnx
ATHEER_GREET_BY_NAME=true

# Clinic formulary (dose limits); a content release's formulary.json overrides it
# ATHEER_FORMULARY_PATH=./formulary.json

# Signed content updates (atheer-admin update-keygen / update-build)
# ATHEER_UPDATE_PUBLIC_KEY=
# ATHEER_UPDATE_MANIFEST_URL=https://your-server/atheer/manifest.json
ATHEER_UPDATE_INTERVAL_MINUTES=360
