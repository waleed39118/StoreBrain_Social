# انسخ هذا الملف إلى .env ثم املأ القيم.  لا ترفع ملف .env إلى git أبداً.
#   cp .env.example .env

# مفتاح توقيع جلسات لوحة التحكم — توليد:  openssl rand -base64 48
JWT_SECRET=

# مفتاح تشفير مفاتيح API المخزّنة في قاعدة البيانات — توليد:  openssl rand -hex 32
API_KEY_SECRET=

# كلمة مرور المدير الأولية — اتركها فارغة لإنشائها من معالج الإعداد في اللوحة
INITIAL_PASSWORD=

# ذاكرة Node بالميغابايت (1024 تكفي للوحة والاستخدام الخفيف)
OMNIROUTE_MEMORY_MB=1024
