# Copy to .env (install.sh does this for you and generates every secret). Never commit .env.
ADA_DOMAIN=shop.example.com
ADA_DATABASE_URL=sqlite:///./data/ada.db

# ---- Auth (required) ----
# python -c "import secrets;print(secrets.token_urlsafe(48))"
ADA_AUTH_SECRET=
ADA_OWNER_PHONE=+9665XXXXXXXX
ADA_OWNER_NAME=Owner
ADA_DEFAULT_COUNTRY_CODE=966
ADA_SESSION_DAYS=30
# One-time code for first-run setup (pairing the SMS phone before the owner exists)
ADA_SETUP_CODE=

# ---- SMS: outbox (owner's Android gateway phone) | http (provider YOU authorise) | console (dev)
ADA_SMS_PROVIDER=outbox
ADA_SMS_GATEWAY_TOKEN=
ADA_SMS_HTTP_URL=
ADA_SMS_HTTP_TOKEN=

# ---- Local AI (Ollama on this server / private network only) ----
ADA_LLM_ENABLED=false
ADA_LLM_URL=http://ollama:11434
ADA_LLM_MODEL=qwen2.5:3b

# ---- Voice (on-server Whisper needs requirements-voice.txt + ffmpeg) ----
ADA_WITH_VOICE=0
ADA_WHISPER_MODEL=small

# ---- Operations ----
ADA_PUBLIC_URL=
ADA_BACKUP_KEEP=14
ADA_BACKUP_INTERVAL_HOURS=24
ADA_LOW_STOCK_ALERT_COOLDOWN_MIN=360
ADA_API_DOCS=false

# ---- Signed catalog patches ----
ADA_UPDATER_ENABLED=false
ADA_UPDATER_URL=
ADA_UPDATER_HMAC_SECRET=
ADA_UPDATER_INTERVAL_SEC=900
