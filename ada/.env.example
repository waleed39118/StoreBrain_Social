# Copy to .env and fill in. Never commit .env.
ADA_DATABASE_URL=sqlite:///./data/ada.db

# ---- Auth (required) ----
# python -c "import secrets;print(secrets.token_urlsafe(48))"
ADA_AUTH_SECRET=
ADA_OWNER_PHONE=+9665XXXXXXXX
ADA_OWNER_NAME=Owner
ADA_DEFAULT_COUNTRY_CODE=966
ADA_SESSION_DAYS=30

# ---- SMS: outbox (owner's Android gateway phone) | http (provider YOU authorise) | console (dev)
ADA_SMS_PROVIDER=outbox
# python -c "import secrets;print(secrets.token_urlsafe(32))"
ADA_SMS_GATEWAY_TOKEN=
ADA_SMS_HTTP_URL=
ADA_SMS_HTTP_TOKEN=

# ---- Voice ----
ADA_WHISPER_MODEL=small
ADA_TTS_RATE=170
ADA_TTS_VOICE_HINT=

ADA_LOW_STOCK_ALERT_COOLDOWN_MIN=360

# ---- Signed catalog patches ----
ADA_UPDATER_ENABLED=false
ADA_UPDATER_URL=
ADA_UPDATER_HMAC_SECRET=
ADA_UPDATER_INTERVAL_SEC=900
